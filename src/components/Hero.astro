---
import { Image } from 'astro:assets';
import horse from '../images/pexels-helenalopes-1996333.jpg';
---

<section class="grid grid-cols-6 lg:grid-cols-12 text-sm px-6 gap-3 lg:gap-6">
    <Image src={horse} alt="" class="col-span-6 h-[40vh] object-cover" />
    <div class="col-span-6 pt-6">
        <div class="font-mono text-4xl pb-3">[lemuel@E14 ~]$</div>
        <div class="font-mono text-xl">0. Grew up in Hong Kong.</div>
        <div class="font-mono text-xl">1. Living in London.</div>
        <div class="font-mono text-xl">
            2. <a
                target="_blank"
                href="https://github.com/LemuelKL"
                class="hover:text-accent"
            >
                GitHub
            </a>
        </div>
        <div class="font-mono text-xl">
            3. <a
                target="_blank"
                href="https://www.linkedin.com/in/lemuelkl/"
                class="hover:text-accent"
            >
                LinkedIn
            </a>
        </div>
        <div class="font-mono text-xl">
            4. <a
                target="_blank"
                href="mailto:lemuellee.kl@gmail.com"
                class="hover:text-accent"
            >
                Email
            </a>
        </div>
        <div class="font-mono text-xl">
            5. <a
                target="_blank"
                href="https://blog.lemuellee.com"
                class="hover:text-accent"
            >
                Blog
            </a>
        </div>
        <div class="font-mono text-xl">
            6. <a target="_blank" href="/cv" class="hover:text-accent">
                Resume
            </a>
        </div>
    </div>
</section>
