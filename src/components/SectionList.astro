---
// SectionList.astro
const { title, data } = Astro.props;
---

<section class="flex flex-col border-t border-border">
    <h2 class="text-xl uppercase tracking-[0.15em] my-12">
        {title}
    </h2>
    <ul class="flex flex-col gap-5 text-sm">
        {
            data.map((item) => (
                <li>
                    <div>
                        {item.link ? (
                            <a
                                href={item.link}
                                target="_blank"
                                class="title-link"
                            >
                                {item.title}
                            </a>
                        ) : (
                            item.title
                        )}
                    </div>
                    <div class="text-muted">{item.organisation}</div>
                    <div class="font-mono text-xs text-muted mt-1">
                        {item.time}
                    </div>
                </li>
            ))
        }
    </ul>
</section>

<style>
    a.title-link {
        color: inherit;
    }

    a.title-link:hover {
        color: var(--color-accent);
    }
</style>
