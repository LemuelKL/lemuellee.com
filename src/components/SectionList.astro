---
// SectionList.astro
const { title, number, data } = Astro.props;
---

<section class="flex flex-col p-6 border-t border-border">
    <div class="flex items-baseline gap-2 mb-6">
        <span class="font-mono text-xs text-muted">{number}</span>
        <h2 class="text-xs uppercase tracking-[0.15em] text-muted">
            {title}
        </h2>
    </div>
    <ul class="flex flex-col gap-5 text-sm">
        {
            data.map((item) => (
                <li>
                    <div>
                        {item.link ? (
                            <a
                                href={item.link}
                                target="_blank"
                                class="title-link"
                            >
                                {item.title}
                            </a>
                        ) : (
                            item.title
                        )}
                    </div>
                    <div class="text-muted">{item.organisation}</div>
                    <div class="font-mono text-xs text-muted mt-1">
                        {item.time}
                    </div>
                </li>
            ))
        }
    </ul>
</section>

<style>
    a.title-link {
        color: inherit;
    }

    a.title-link:hover {
        color: var(--color-accent);
    }
</style>
