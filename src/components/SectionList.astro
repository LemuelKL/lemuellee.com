---
// SectionList.astro
const { title, data } = Astro.props
---

<section class="flex flex-col gap-6 p-6">
    <div class="mb-6 border-t">
        <div>{title}</div>
    </div>
    <div class="pb-2 mb-2 text-sm flex flex-col">
        {
            data.map((item, index) => (
                <div>
                    {item.link ? (
                        <a href={item.link} target="_blank" class="title-link">
                            {item.title}
                        </a>
                    ) : (
                        item.title
                    )}
                </div>
                <div class="flex flex-col">
                    <div>{item.organisation}</div>
                </div>
                <div>{item.time}</div>
                <div class="mb-6"></div>
            ))
        }
    </div>
</section>

<style>
    a.title-link {
        color: inherit;
    }

    a.title-link:hover {
        color: var(--color-accent);
    }
</style>
