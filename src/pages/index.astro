---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CV from '../components/CV.astro';
---

<BaseLayout>
    <div class="flex flex-col">
        <Hero />
        <CV />
        <footer
            class="border-t border-border py-6 flex flex-col sm:flex-row sm:justify-between gap-1 font-mono text-xs text-muted"
        >
            <p>&copy; {new Date().getFullYear()} Lemuel Lee</p>
            <p>
                <a
                    href="https://github.com/LemuelKL/lemuellee.com"
                    target="_blank"
                >
                    Source
                </a>
                — built with Astro and Tailwind CSS
            </p>
        </footer>
    </div>
</BaseLayout>
